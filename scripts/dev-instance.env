# The test instance: what Claude (and you, when hacking) run against, next to the
# installed app. Its own folders, ports and bot computers (prefixed dev-), so it
# can be restarted, rebuilt and broken without touching the real instance.
#
#   set -a; . scripts/dev-instance.env; set +a
#   node packages/daemon/src/index.ts          # or: systemctl --user start grokked-dev
#   pnpm eval                                   # evals then target this instance
#
# The installed app (.deb/AppImage) is the real one: ~/.config/grokked-app,
# ~/.local/share/grokked-app, ports 8797/8798.
GROKKED_CONFIG_DIR=${HOME}/.config/grokked-dev
GROKKED_DATA_DIR=${HOME}/.local/share/grokked-dev
GROKKED_RUNTIME_DIR=/run/user/1000/grokked-dev
GROKKED_PORT=8777
GROKKED_HOOKS_PORT=8778
GROKKED_CONTAINER_PREFIX=dev-
GROKKED_IMAGE=grokked/computer:dev
