{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Grokked Bot desktop client",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-daemon-token",
    "allow-daemon-url",
    "allow-daemon-status",
    "allow-start-daemon",
    "allow-daemon-logs",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/.local/share/grokked-app/bots/**"
        },
        {
          "path": "$HOME/.local/share/grokked-dev/bots/**"
        },
        {
          "path": "$HOME/.local/share/grokked/bots/**"
        },
        {
          "path": "$HOME/Library/Application Support/Grokked/bots/**"
        }
      ]
    }
  ]
}
