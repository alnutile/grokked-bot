{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Grokked Bot desktop client",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-daemon-token",
    "allow-daemon-url",
    "allow-daemon-status",
    "allow-start-daemon",
    "allow-daemon-logs"
  ]
}
