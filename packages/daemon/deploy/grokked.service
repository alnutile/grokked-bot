[Unit]
Description=Grokked Bot daemon
Documentation=https://github.com/alnutile/grokked-bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=8

[Service]
Type=simple
EnvironmentFile=%h/.config/grokked/env
Environment=NODE_ENV=production
# Runs straight from the repo (Node 24 strips types natively). The node path and
# repo path are filled in at install time -- see "Install the daemon" in the README.
ExecStart=@NODE@ @REPO@/packages/daemon/src/index.ts
WorkingDirectory=@REPO@
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=30
MemoryMax=2G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
