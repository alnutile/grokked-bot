#!/bin/bash
# First boot: an XFCE desktop streamed by Amazon DCV, Docker, and Grokked Bot.
# Log: /var/log/grokked-setup.log (ends with GROKKED-SETUP-DONE).
set -euxo pipefail
exec > >(tee -a /var/log/grokked-setup.log) 2>&1
export DEBIAN_FRONTEND=noninteractive
NAME='${name}'
REGION='${region}'
VERSION='${grokked_version}'

apt-get update
apt-get install -y --no-install-recommends xfce4 xfce4-terminal xfce4-goodies dbus-x11 xauth \
  unzip curl jq docker.io pulseaudio mesa-utils
snap install chromium || true
snap install aws-cli --classic || true
AWS=/snap/bin/aws
param() { $AWS ssm get-parameter --region "$REGION" --name "$1" --with-decryption --query Parameter.Value --output text 2>/dev/null; }

# The ubuntu user signs in to DCV with the password from Parameter Store.
echo "ubuntu:$(param "/$NAME/desktop-password")" | chpasswd
usermod -aG docker ubuntu

# ---- Amazon DCV, virtual sessions (no GPU needed)
cd /tmp
curl -fsSLO https://d1uj6qtbmh3dt5.cloudfront.net/NICE-GPG-KEY && gpg --import NICE-GPG-KEY
curl -fsSLO https://d1uj6qtbmh3dt5.cloudfront.net/nice-dcv-ubuntu2404-x86_64.tgz
tar xzf nice-dcv-ubuntu2404-x86_64.tgz && cd nice-dcv-*-ubuntu2404-x86_64
apt-get install -y ./nice-dcv-server_*.deb ./nice-dcv-web-viewer_*.deb ./nice-xdcv_*.deb

# No automatic session: DCV would make a "console" session, and a virtual
# session can't exist next to one. The unit below makes the desktop instead.
cat > /etc/dcv/dcv.conf <<'EOF'
[license]
[log]
[session-management]
create-session = false
[display]
[connectivity]
web-port = 8443
enable-quic-frontend = false
[security]
authentication = "system"
EOF
cat > /etc/dcv/xfce-session.sh <<'EOF'
#!/bin/sh
exec dbus-launch --exit-with-session startxfce4
EOF
chmod +x /etc/dcv/xfce-session.sh
cat > /etc/systemd/system/dcv-desktop.service <<'EOF'
[Unit]
Description=DCV desktop session for ubuntu
After=dcvserver.service
Requires=dcvserver.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/dcv create-session --type virtual --owner ubuntu --init /etc/dcv/xfce-session.sh desktop
ExecStop=/usr/bin/dcv close-session desktop
[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now dcvserver
systemctl enable --now dcv-desktop

# ---- Grokked Bot
curl -fsSL -o /tmp/grokked.deb "https://github.com/alnutile/grokked-bot/releases/download/v$VERSION/Grokked-Bot-linux-amd64.deb"
apt-get install -y /tmp/grokked.deb
docker pull "ghcr.io/alnutile/grokked-computer:$VERSION" || true
loginctl enable-linger ubuntu

# The app's settings: the OpenRouter key if it's in Parameter Store (see
# openrouter_key_parameter), and the webhook listener on all interfaces so
# CloudFront can reach it (the security group only lets CloudFront in).
D=/home/ubuntu/.config/grokked-app
mkdir -p "$D"
{
  KEY=$(param '${key_param}' || true)
  [ -n "$KEY" ] && echo "OPENROUTER_API_KEY=$KEY"
%{ if webhooks ~}
  echo "GROKKED_HOOKS_HOST=0.0.0.0"
%{ endif ~}
  true
} > "$D/env"
unset KEY
# Start the app with the desktop session (which starts at boot), so webhooks
# and schedules keep working after a reboot without anyone signing in.
mkdir -p /home/ubuntu/.config/autostart
cp '/usr/share/applications/Grokked Bot.desktop' /home/ubuntu/.config/autostart/grokked-bot.desktop
chown -R ubuntu:ubuntu /home/ubuntu/.config
chmod 600 "$D/env"

echo GROKKED-SETUP-DONE
